{
  "credentials_file": "work/credentials/application.json",
  "bible": {
    "base_url": "https://rest.api.bible/v1",
    "bible_id": "78a9f6124f344018-01",
    "name": "New International Version 2011",
    "api_key_env": "API_BIBLE_KEY"
  },
  "word_study": {
    "see_also_format": "See also {references} (NIV)",
    "handout_full_verses_per_testament_per_word": 3,
    "handout_full_verses_by_word_count": {"3": 3, "4": 2},
    "verses_per_testament_per_word": 6,
    "page_size": 50,
    "max_pages_per_testament": 2,
    "timeout_seconds": 30,
    "cache_directory": "work/research/api-bible-cache",
    "ranges": {
      "old_testament": "GEN.1.1-MAL.4.6",
      "new_testament": "MAT.1.1-REV.22.21"
    }
  },
  "llm": {
    "provider": "none",
    "note": "Collection uses Python only. rank-word-study.py explicitly invokes the configured Gemini profile to rank existing research.",
    "timeout_seconds": 60,
    "profiles": {
      "gemini": {
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "model": "gemini-3.5-flash-lite",
        "api_key_env": "GEMINI_API_KEY"
      },
      "openai": {
        "base_url": "https://api.openai.com/v1",
        "model": "gpt-5-mini",
        "api_key_env": "OPENAI_API_KEY"
      }
    }
  }
}
